<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Затемнённый фон -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true" />

    <!-- Карточка настроек -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white_15">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/toggle_button_background">

            <!-- Заголовок -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center" />

            <!-- Цветовая палитра -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цветовая палитра"
                android:textSize="16sp"
                android:textColor="@color/white_90"
                android:layout_marginBottom="12dp" />

            <!-- Превью цвета -->
            <View
                android:id="@+id/colorPreview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:background="@drawable/color_preview_background"
                android:elevation="4dp" />

            <!-- Слайдер выбора цвета (Hue: 0-360) -->
            <SeekBar
                android:id="@+id/colorHueSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="360"
                android:progress="270"
                android:progressTint="@color/white"
                android:thumbTint="@color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/colorHueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Оттенок: 270°"
                android:textSize="14sp"
                android:textColor="@color/white_70"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center" />

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_30"
                android:layout_marginVertical="16dp" />

            <!-- Отображение времени -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Показывать обычное время"
                    android:textSize="16sp"
                    android:textColor="@color/white_90" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/timeVisibilitySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <!-- Кнопка закрыть -->
            <Button
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Закрыть"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_premium"
                android:layout_marginTop="24dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
