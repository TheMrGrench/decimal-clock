<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Затемнённый фон -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true" />

    <!-- Карточка будильника -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white_15">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/toggle_button_background">

                <!-- Заголовок -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Будильник"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="24dp"
                    android:layout_gravity="center" />

                <!-- Выбор времени -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp">

                    <NumberPicker
                        android:id="@+id/hoursPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:theme="@style/TimePickerTheme" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="48sp"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:paddingHorizontal="16dp" />

                    <NumberPicker
                        android:id="@+id/minutesPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:theme="@style/TimePickerTheme" />

                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white_30"
                    android:layout_marginVertical="16dp" />

                <!-- Время до звонка -->
                <TextView
                    android:id="@+id/timeUntilAlarmLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Будильник прозвонит через:"
                    android:textSize="14sp"
                    android:textColor="@color/white_70"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timeUntilAlarmDecimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Десятичное: 3:50:00"
                    android:textSize="16sp"
                    android:textColor="@color/white_90"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/timeUntilAlarmStandard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обычное: 9 ч 21 мин"
                    android:textSize="16sp"
                    android:textColor="@color/white_90"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Разделитель -->
                <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white_30"
                    android:layout_marginVertical="16dp"
                    android:visibility="gone" />

                <!-- Кнопки управления -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/setAlarmButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Установить"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_premium"
                        android:layout_marginEnd="8dp"
                        android:elevation="4dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/cancelAlarmButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Отменить"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_premium"
                        android:layout_marginStart="8dp"
                        android:elevation="4dp"
                        android:stateListAnimator="@null"
                        android:enabled="false" />

                </LinearLayout>

                <!-- Кнопка закрыть -->
                <Button
                    android:id="@+id/closeButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Закрыть"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_premium"
                    android:layout_marginTop="16dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</FrameLayout>
