<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Затемнённый фон -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true" />

    <!-- Карточка таймера -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white_15">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/toggle_button_background">

            <!-- Заголовок -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Таймер (десятичное время)"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center" />

            <!-- Отображение времени -->
            <TextView
                android:id="@+id/timerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00:00"
                android:textSize="48sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Пресеты -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Быстрый выбор (десятичные минуты):"
                android:textSize="14sp"
                android:textColor="@color/white_90"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="3"
                android:layout_marginBottom="16dp">

                <Button android:id="@+id/preset1" style="@style/PresetButtonStyle" android:text="1" />
                <Button android:id="@+id/preset2" style="@style/PresetButtonStyle" android:text="2" />
                <Button android:id="@+id/preset3" style="@style/PresetButtonStyle" android:text="3" />
                <Button android:id="@+id/preset5" style="@style/PresetButtonStyle" android:text="5" />

                <Button android:id="@+id/preset10" style="@style/PresetButtonStyle" android:text="10" />
                <Button android:id="@+id/preset15" style="@style/PresetButtonStyle" android:text="15" />
                <Button android:id="@+id/preset20" style="@style/PresetButtonStyle" android:text="20" />
                <Button android:id="@+id/preset30" style="@style/PresetButtonStyle" android:text="30" />

                <Button android:id="@+id/preset1h" style="@style/PresetButtonStyle" android:text="1ч" />
                <Button android:id="@+id/preset2h" style="@style/PresetButtonStyle" android:text="2ч" />
                <Button android:id="@+id/preset3h" style="@style/PresetButtonStyle" android:text="3ч" />

            </GridLayout>

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_30"
                android:layout_marginVertical="16dp" />

            <!-- Своё время -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Или введите своё время:"
                android:textSize="14sp"
                android:textColor="@color/white_90"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/customHours"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:hint="ч"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white_50"
                    android:backgroundTint="@color/white_50"
                    android:textAlignment="center"
                    android:maxLength="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:layout_marginHorizontal="8dp" />

                <EditText
                    android:id="@+id/customMinutes"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:hint="м"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white_50"
                    android:backgroundTint="@color/white_50"
                    android:textAlignment="center"
                    android:maxLength="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:layout_marginHorizontal="8dp" />

                <EditText
                    android:id="@+id/customSeconds"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:hint="с"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white_50"
                    android:backgroundTint="@color/white_50"
                    android:textAlignment="center"
                    android:maxLength="2" />

            </LinearLayout>

            <!-- Кнопки управления -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Старт"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_premium"
                    android:layout_marginEnd="8dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Сброс"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_premium"
                    android:layout_marginStart="8dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- Кнопка закрыть -->
            <Button
                android:id="@+id/closeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Закрыть"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_premium"
                android:layout_marginTop="16dp"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
